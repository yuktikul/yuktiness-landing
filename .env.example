# Public URL of this site (used for Open Graph / canonical URLs)
NEXT_PUBLIC_SITE_URL="https://masterclass.yuktiness.com"

# Video sales letter. Leave empty to show the placeholder.
# Accepts a YouTube or Vimeo link, or a direct .mp4 / .webm URL.
NEXT_PUBLIC_VSL_URL=""

# CRM connection (server-side only, never exposed to the browser)
CRM_API_URL="http://localhost:3100"
CRM_API_KEY="same value as LANDING_API_KEY in yuktiness-crm/.env"
