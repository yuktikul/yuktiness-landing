# Public URL of this site (used for Open Graph / canonical URLs)
NEXT_PUBLIC_SITE_URL="https://masterclass.yuktiness.com"

# Video sales letter. Leave empty to show the placeholder.
# Accepts a YouTube or Vimeo link, or a direct .mp4 / .webm URL.
NEXT_PUBLIC_VSL_URL=""

# CRM connection (server-side only, never exposed to the browser)
CRM_API_URL="http://localhost:3100"
CRM_API_KEY="same value as LANDING_API_KEY in yuktiness-crm/.env"

# Checkout (academy platform, Razorpay). Empty → "Payment link coming soon" screen.
CHECKOUT_URL="https://wahacademy.yuktiness.com/web/checkout/6a719e2e03959b96644a66dc?purchaseNow=true"

# Prefill the checkout with the visitor's details (ours=theirs pairs). Confirmed to work on the
# TagMango checkout. Empty = plain URL.
CHECKOUT_PREFILL_PARAMS="name=name,email=email,phone=phone"

# Where signups are written if the CRM can't be reached (replay with `npm run queue:replay`).
SIGNUP_QUEUE_FILE=".data/signup-queue.jsonl"
